# 本机配置（本机配置与共享代码分离）
.ir-workbench/

# 若有人误把旧仓拷进根目录：忽略，避免变成第二套入口。
0703_Travel_Pulse/
database_matain/
peers_rs_update/
peers_model_scripts/
update-shareholder-list/

# 一次性产物
scratch/
_tmp/

# 每期原件（券商周报、研报 PDF、STR 表等）：只服务当期，体积大且多为第三方材料。
# 原件不进 git。收件说明 README 和空目录 .gitkeep 随包走。
inputs/**
!inputs/**/
!inputs/**/.gitkeep
!inputs/README.md
!inputs/**/README.md

# 交付物的 HTML/PDF：由 .md 一键重放，且内嵌三份 woff2 字体后单份约 4.6 MB。
# Markdown 才是交付物真源，进 git；渲染结果不进（旧仓 reports/INDEX.md 已是同一约定）。
outputs/**/*.html
outputs/**/*.pdf

# 卖方研报按页抽取会包含大段受版权/合规约束的原文，只服务当次内部摘读。
# 不建持久层（ADR 0004），也绝不能误进公开作品集导出。
outputs/sellside-research/**

# Peers Model 运行副本含完整财务 Excel 与 PDF 抽取原文，只留在本机。
outputs/peers-model/

# Peers 权威 Model：本机锁定，只出副本，不进 Git。说明文件随包走。
data/models/**
!data/models/README.md

# Shareholder list 生成的完整工作簿（与 peers-model 一样只留本机）。
outputs/shareholder-list/

# 第一次迁入时误写在仓库根 output/ 的残留，不进 git。
output/
.worktrees/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Excel 临时锁文件
~$*.xls*

# 环境
.venv/
.env

# 专家访谈原件与抽取文本含第三方/内部材料；只保留 schema、模板和 manifest。
test_expert_calls/
modules/expert_calls/**/*.pdf
modules/expert_calls/**/*.txt
runs/expert-calls/**/*.pdf
runs/expert-calls/**/*.txt
outputs/expert-calls/**/*.txt
